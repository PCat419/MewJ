# 雀魂账号（邮箱或手机号）— 仅在用链接下载牌谱时需要
MAJSOUL_USERNAME=
# 雀魂密码
MAJSOUL_PASSWORD=
# 可选：强制 Unity 资源版本（默认自动探测并缓存）
# MAJSOUL_RES_VERSION=0.16.255
# 可选：浏览器 access_token（密码登录失败时用）
# localStorage.getItem('access_token')
# MAJSOUL_ACCESS_TOKEN=
# MAJSOUL_OAUTH_TYPE=0
# 可选代理，例如 socks5://127.0.0.1:10808 或 http://127.0.0.1:7890
# MAJSOUL_PROXY=
# 可选：nanikiru 地址（默认 http://127.0.0.1:50000）
# NANIKIRU_URL=http://127.0.0.1:50000
# 可选：并行 nanikiru 进程数（默认 4；也可用 CLI --workers）
# MEWJ_WORKERS=4
# 可选：nanikiru 路径（Windows 默认 engine/nanikiru.exe，其他系统默认 engine/nanikiru）
# MEWJ_NANIKIRU_EXE=
# Web 模式：local 会打开浏览器并自动退出；server 为常驻服务
# MEWJ_WEB_MODE=local
# 报告模式：local 使用离线天凤资源；server 使用适合发送的在线回放
# MEWJ_REPORT_MODE=local
# MEWJ_WEB_HOST=127.0.0.1
# MEWJ_WEB_PORT=8765
