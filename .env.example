# 雀魂账号（邮箱或手机号）— 仅在用链接下载牌谱时需要
MAJSOUL_USERNAME=
# 雀魂密码
MAJSOUL_PASSWORD=
# 可选：强制 Unity 资源版本（默认自动探测并缓存）
# MAJSOUL_RES_VERSION=0.16.255
# 可选：浏览器 access_token（密码登录失败时用）
# localStorage.getItem('access_token')
# MAJSOUL_ACCESS_TOKEN=
# MAJSOUL_OAUTH_TYPE=0
# 可选代理，例如 socks5://127.0.0.1:10808 或 http://127.0.0.1:7890
# MAJSOUL_PROXY=
# 可选：nanikiru 地址（默认 http://127.0.0.1:50000）
# NANIKIRU_URL=http://127.0.0.1:50000
